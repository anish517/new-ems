# /etc/systemd/system/ems-reminders.service  (triggered by ems-reminders.timer)
# The APScheduler job in calendar_app only starts under `runserver` (RUN_MAIN=true), so it
# never ran under Passenger and would not run under gunicorn either. This is its replacement.
[Unit]
Description=OmWay EMS daily calendar event reminders
After=postgresql.service

[Service]
Type=oneshot
User=omway
Group=www-data
WorkingDirectory=/srv/ems/app
ExecStart=/srv/ems/venv/bin/python manage.py send_event_reminders
